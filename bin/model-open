#!/bin/bash
# Called by Claude Code's /model command. Handles all logic outside the AI.
# Usage: model-open [arg]  where arg is: blank/status, <model-id>, or "clear"

ARG="${*:-}"
ACTIVE="$HOME/.claude/active-model"
CUR=$([ -f "$ACTIVE" ] && cat "$ACTIVE" | tr -d '\n' || echo "none")
PROXY="${PROXY_URL:-http://127.0.0.1:4001}"

show_model_list() {
  local MODELS_JSON
  MODELS_JSON=$(curl -s --max-time 5 "$PROXY/v1/models" 2>/dev/null)
  if [ -z "$MODELS_JSON" ]; then
    echo "⚠️  Proxy not reachable at $PROXY"
    echo "   Start it: node ~/opencode-proxy-server.js &"
    return
  fi
  echo "📋 Available models:"
  echo ""
  MODELS_JSON="$MODELS_JSON" python3 << 'PYEOF'
import json, os
try:
    data = json.loads(os.environ['MODELS_JSON'])
    models = data.get('data', [])
    groups = {}
    for m in models:
        mid = m.get('id', '')
        owner = m.get('owned_by', '')
        if not mid:
            continue
        if '/' in mid:
            prefix = mid.split('/')[0]
        elif 'groq' in owner.lower():
            prefix = 'groq'
        elif 'nvidia' in owner.lower():
            prefix = 'nvidia'
        elif 'openrouter' in owner.lower():
            prefix = 'openrouter'
        elif 'ollama' in owner.lower():
            prefix = 'ollama'
        elif 'github' in owner.lower() or 'copilot' in owner.lower():
            prefix = 'copilot'
        elif 'anthropic' in owner.lower():
            prefix = 'anthropic'
        elif 'google' in owner.lower():
            prefix = 'gemini'
        else:
            prefix = 'opencode'
        groups.setdefault(prefix, []).append((mid, owner))
    order = ['copilot', 'opencode', 'gemini', 'openai', 'groq', 'nvidia', 'openrouter', 'ollama', 'anthropic']
    labels = {'copilot': 'GitHub Copilot', 'opencode': 'OpenCode Zen',
              'gemini': 'Google Gemini', 'openai': 'OpenAI', 'groq': 'Groq',
              'nvidia': 'Nvidia NIM', 'openrouter': 'OpenRouter',
              'ollama': 'Ollama (local)', 'anthropic': 'Anthropic Direct'}
    for grp in order + sorted(set(groups) - set(order)):
        if grp not in groups:
            continue
        label = labels.get(grp, grp.title())
        print(f'  ── {label} ──')
        for mid, owner in groups[grp]:
            rate_tag = ''
            if '[' in owner:
                rate_tag = '  ' + owner[owner.index('['):]
            print(f'    {mid}{rate_tag}')
        print()
except Exception as e:
    print(f'  (error parsing model list: {e})')
PYEOF
  echo "💡 Switch model: /model <model-id>"
  echo "   Example:  /model copilot/gpt-5-mini"
  echo "   Picker:   run 'model' in a terminal (fzf arrow-key selector)"
}

case "$ARG" in
  ""|"status")
    echo "Active model: $CUR"
    echo ""
    show_model_list
    ;;
  "clear")
    rm -f "$ACTIVE"
    echo "✅ Model override cleared."
    ;;
  *)
    # If no provider prefix, try to fuzzy-match against available models
    if [[ "$ARG" != *"/"* ]]; then
      CACHE="$HOME/.claude/model-cache.json"
      CACHE_TTL=600  # 10 minutes
      NOW=$(date +%s)
      MTIME=$(stat -f %m "$CACHE" 2>/dev/null || echo 0)
      if [ ! -f "$CACHE" ] || [ $(( NOW - MTIME )) -gt $CACHE_TTL ]; then
        curl -s --max-time 5 "$PROXY/v1/models" > "$CACHE" 2>/dev/null
      fi
      MODELS_JSON=$(cat "$CACHE" 2>/dev/null)
      MATCH=$(QUERY="$ARG" MODELS_JSON="$MODELS_JSON" python3 << 'FUZZY'
import json, sys, os
arg = os.environ.get('QUERY', '').lower()
raw = os.environ.get('MODELS_JSON', '')
try:
    data = json.loads(raw)
except Exception:
    sys.exit(1)
models = [m['id'] for m in data.get('data', [])]
norm = lambda s: s.lower().replace('.', '-').replace('_', '-')
# Exact suffix match (e.g. "claude-sonnet-4.6" matches "copilot/claude-sonnet-4.6")
for mid in models:
    if norm(mid.split('/')[-1]) == norm(arg):
        print(mid); sys.exit(0)
# Substring match
for mid in models:
    if norm(arg) in norm(mid):
        print(mid); sys.exit(0)
sys.exit(1)
FUZZY
)
      if [ -n "$MATCH" ]; then
        echo "⚠️  '$ARG' → auto-matched to '$MATCH'"
        ARG="$MATCH"
      else
        echo "❌ '$ARG' needs a provider prefix (e.g. copilot/claude-sonnet-4.6)"
        echo ""
        echo "   Common models:"
        echo "     copilot/gpt-5-mini        copilot/claude-sonnet-4.6"
        echo "     copilot/claude-haiku-4.5  opencode/deepseek-v4-flash"
        echo ""
        echo "   Use /model (no args) to see all available models."
        exit 1
      fi
    fi
    mkdir -p "$(dirname "$ACTIVE")"
    echo "$ARG" > "$ACTIVE"
    echo "✅ Switched to: $ARG"
    echo "   Takes effect on your next message."
    ;;
esac
