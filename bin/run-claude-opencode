#!/bin/bash

# run-claude-opencode: Launch Claude Code with OpenCode Proxy
# Features:
#   - Injects all 57+ proxy models into Claude Code's NATIVE "Select model" picker
#   - Interactive terminal model picker at startup
#   - Automatic proxy startup
#   - --dangerously-skip-permissions enabled by default
#   - Restores original model list when Claude exits
#
# USAGE:
#   run-claude-opencode                    # Show interactive picker (all models)
#   run-claude-opencode gpt-4o            # Use specific model directly
#   run-claude-opencode -m minimax-m2.7   # Use specific model (alt syntax)

set -e

PROXY_CONFIG_DIR="$HOME/.claude-proxy"
PROXY_SETTINGS="$PROXY_CONFIG_DIR/settings.json"
PROXY_URL="http://127.0.0.1:4001"
REPO_DIR="$HOME/Claude-Opencode-Ollama"

# Pick python binary that works (3.11 avoids 3.14 build issues)
PYTHON_BIN=$(which python3.11 2>/dev/null || which python3 2>/dev/null || echo "python3")

# Parse arguments
MODEL_ARG=""
EXTRA_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model)
      MODEL_ARG="$2"
      shift 2
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

# If first extra arg looks like a model name (not a flag), treat as model
if [[ -z "$MODEL_ARG" && ${#EXTRA_ARGS[@]} -gt 0 && "${EXTRA_ARGS[0]}" != -* ]]; then
  MODEL_ARG="${EXTRA_ARGS[0]}"
  EXTRA_ARGS=("${EXTRA_ARGS[@]:1}")
fi

# Ensure config exists
if [ ! -f "$PROXY_SETTINGS" ]; then
  echo "❌ Proxy settings not found: $PROXY_SETTINGS"
  exit 1
fi

# Ensure proxy is running
if ! nc -zv 127.0.0.1 4001 > /dev/null 2>&1; then
  echo "🚀 Starting proxy server..."
  cd "$REPO_DIR"
  # Start proxy detached so it survives when Claude Code closes
  nohup node opencode-proxy-server.js > /tmp/opencode-proxy.log 2>&1 &
  
  echo "⏳ Waiting for proxy to start..."
  for i in {1..30}; do
    if nc -zv 127.0.0.1 4001 > /dev/null 2>&1; then
      echo "✅ Proxy is running"
      break
    fi
    if [ $i -eq 30 ]; then
      echo "❌ Proxy failed to start. Check: /tmp/opencode-proxy.log"
      exit 1
    fi
    sleep 1
  done
fi

# If no model specified, show interactive picker
if [[ -z "$MODEL_ARG" ]]; then
  echo ""
  echo "╔════════════════════════════════════════════════════════════════╗"
  echo "║      Claude Code — PROXY MODE                                  ║"
  echo "║      Proxy: http://127.0.0.1:4001                              ║"
  echo "╚════════════════════════════════════════════════════════════════╝"
  echo ""

  # Fetch models from proxy
  MODELS_JSON=$(curl -sf --max-time 5 "$PROXY_URL/v1/models" 2>/dev/null)

  if [[ -z "$MODELS_JSON" ]]; then
    echo "⚠️  Could not fetch models from proxy. Using default: gpt-4o"
    MODEL_ARG="gpt-4o"
  else
    # Read current active model for pre-selection indicator
    CURRENT_MODEL=""
    if [[ -f "$HOME/.claude/active-model" ]]; then
      _content=$(cat "$HOME/.claude/active-model" | tr -d '\n')
      if [[ "$_content" == "{"* ]]; then
        CURRENT_MODEL=$(echo "$_content" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('model',''))" 2>/dev/null || echo "")
      else
        CURRENT_MODEL="$_content"
      fi
    fi

    # Build display lines (model-id + rate + owner)
    LINES=$(echo "$MODELS_JSON" | "$PYTHON_BIN" -c "
import sys, json
cur = '$CURRENT_MODEL'
data = json.load(sys.stdin)
for m in data.get('data', []):
    mid   = m.get('id', '')
    owner = m.get('owned_by', 'other')
    rate  = m.get('x_copilot_rate')
    if not mid: continue
    if rate == 0:          rate_str = '0x'
    elif rate is not None: rate_str = f'{rate}x'
    else:                  rate_str = '  '
    active = '✓' if mid == cur else ' '
    print(f'{active}  {mid:<42} {rate_str:<7}  {owner}')
")

    MODEL_COUNT=$(echo "$LINES" | grep -c . 2>/dev/null || echo "0")
    FZF_BIN=$(which fzf 2>/dev/null || echo "")

    if [[ -n "$FZF_BIN" ]]; then
      # Interactive fzf arrow-key picker
      SELECTED=$(echo "$LINES" | "$FZF_BIN" \
        --ansi \
        --prompt="  Search models... " \
        --pointer="▶" \
        --marker="✓" \
        --height=50% \
        --layout=reverse \
        --border=rounded \
        --border-label=" ⚡ Select Model " \
        --border-label-pos=3 \
        --info=inline \
        --header="  ↑↓ arrows · type to search · Enter to select   ✓ = last used   0x=FREE
  Active: ${CURRENT_MODEL:-none}   ($MODEL_COUNT models available)" \
        --header-first \
        --bind "ctrl-c:abort,esc:abort" \
        --no-preview) || true

      if [[ -z "$SELECTED" ]]; then
        echo "Cancelled."
        exit 0
      fi
      # Strip leading ✓ or spaces marker, then grab first field = model ID
      MODEL_ARG=$(echo "$SELECTED" | sed 's/^[✓ ]*//' | awk '{print $1}')
    else
      # Fallback: numbered list (fzf not installed)
      declare -a model_array
      index=0
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        mid=$(echo "$line" | awk '{print $2}')
        model_array[$index]="$mid"
        printf "  %2d. %s\n" $((index + 1)) "$line"
        index=$((index + 1))
      done <<< "$LINES"

      TOTAL=${#model_array[@]}
      echo ""
      read -r -p "Choice (1-${TOTAL}) or model name [Enter = ${CURRENT_MODEL:-gpt-4o}]: " choice

      if [[ -z "$choice" ]]; then
        MODEL_ARG="${CURRENT_MODEL:-gpt-4o}"
      elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 && $choice -le $TOTAL ]]; then
        MODEL_ARG="${model_array[$((choice - 1))]}"
      else
        MODEL_ARG="$choice"
      fi
    fi
  fi
fi

# Persist selected model — proxy reads this file on every request
# Validate: reject rate labels (0x, FREE, etc.) and bare provider names
if [[ "$MODEL_ARG" =~ ^[0-9]*x$ ]] || [[ "$MODEL_ARG" == "FREE" ]] || [[ "$MODEL_ARG" == "opencode" ]] || [[ "$MODEL_ARG" == "copilot" ]] || [[ "$MODEL_ARG" == "ollama" ]]; then
  echo "⚠️  '$MODEL_ARG' is not a valid model ID — keeping previous model"
  MODEL_ARG=$(cat "$HOME/.claude/active-model" 2>/dev/null || echo "opencode/minimax-m2.5-free")
fi
printf "%s" "$MODEL_ARG" > "$HOME/.claude/active-model"

echo ""
echo "▶  Model:  $MODEL_ARG"
echo "   Proxy:  $PROXY_URL"
echo ""

# Build temp settings JSON with selected model
TEMP_SETTINGS=$(mktemp /tmp/claude-proxy-settings-XXXXXX)
"$PYTHON_BIN" - <<PYEOF
import json
with open("$PROXY_SETTINGS") as f:
    settings = json.load(f)
settings["model"] = "$MODEL_ARG"
with open("$TEMP_SETTINGS", "w") as f:
    json.dump(settings, f, indent=2)
PYEOF

# Inject all proxy models into Claude Code's native "Select model" picker
GATEWAY_CACHE="$HOME/.claude/cache/gateway-models.json"
GATEWAY_ORIGINAL="$HOME/.claude/cache/gateway-models-original.json"

"$PYTHON_BIN" - <<PYEOF
import json, urllib.request, os, time, shutil

gateway_cache = os.path.expanduser('~/.claude/cache/gateway-models.json')
# Permanent original — saved once, preserved across crashes
original_path = os.path.expanduser('~/.claude/cache/gateway-models-original.json')

# On first ever run, save the true original permanently
if not os.path.exists(original_path) and os.path.exists(gateway_cache):
    shutil.copy2(gateway_cache, original_path)

# Read original models to keep them in the picker
if os.path.exists(original_path):
    with open(original_path) as f:
        orig_data = json.load(f)
    original_models = orig_data.get('models', [])
elif os.path.exists(gateway_cache):
    with open(gateway_cache) as f:
        orig_data = json.load(f)
    original_models = orig_data.get('models', [])
else:
    original_models = []
    os.makedirs(os.path.dirname(gateway_cache), exist_ok=True)

# Fetch proxy models from our running proxy
try:
    with urllib.request.urlopen('http://127.0.0.1:4001/v1/models', timeout=5) as r:
        data = json.loads(r.read().decode())
        proxy_models = []
        for m in data.get('data', []):
            model_id = m.get('id', '')
            if not model_id:
                continue
            # Use anthropic/ prefix — Claude Code's picker only shows models with this prefix
            if model_id.startswith('gh-copilot/'):
                name = model_id[len('gh-copilot/'):]
                gateway_id = f'anthropic/gh-copilot/{name}'
                display = f'GitHub Copilot / {name}'
            else:
                # OpenCode Zen model (bare name)
                gateway_id = f'anthropic/opencode/{model_id}'
                display = f'opencode / {model_id}'
            proxy_models.append({'id': gateway_id, 'display_name': display})
except Exception as e:
    proxy_models = []

# Merge: proxy models first, then keep original native Claude models (deduplicate)
seen_ids = {m['id'] for m in proxy_models}
for m in original_models:
    if m['id'] not in seen_ids:
        proxy_models.append(m)
        seen_ids.add(m['id'])

# Write merged cache — Claude Code reads this for its native "Select model" picker
new_cache = {
    'baseUrl': 'http://127.0.0.1:4001',
    'fetchedAt': int(time.time() * 1000),
    'models': proxy_models
}
with open(gateway_cache, 'w') as f:
    json.dump(new_cache, f, indent=2)

proxy_count = len([m for m in proxy_models if not m['id'].startswith('claude-')])
orig_count = len(original_models)
print(f'✅ Native picker: {proxy_count} proxy models + {orig_count} original models = {len(proxy_models)} total')
PYEOF

# Cleanup function — restores original gateway-models.json when Claude exits
cleanup_gateway() {
  if [ -f "$GATEWAY_ORIGINAL" ]; then
    cp "$GATEWAY_ORIGINAL" "$GATEWAY_CACHE" 2>/dev/null || true
  fi
  rm -f "$TEMP_SETTINGS" 2>/dev/null || true
  # Reset terminal/tmux pane title so stale model name doesn't persist
  printf '\033]0;shell\007' 2>/dev/null || true
  printf '\033]2;\007' 2>/dev/null || true
}
trap cleanup_gateway EXIT

# Launch Claude with proxy settings (not exec — trap must fire on exit)
claude --settings "$TEMP_SETTINGS" --dangerously-skip-permissions "${EXTRA_ARGS[@]}"
