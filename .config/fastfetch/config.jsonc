{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",

  "display": {
    "separator": " : ",
    "color": {
      "keys": "green",
      "title": "green"
    }
  },

  "logo": {
    "type": "builtin",
    "source": "Apple",
    "color": {
      "1": "#50fa7b",
      "2": "#f1fa8c",
      "3": "#ffb86c",
      "4": "#ff5555",
      "5": "#bd93f9",
      "6": "#8be9fd"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "About This Mac"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "terminal",     "key": "Terminal" },
    "display",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    { "type": "localip",      "key": "Local IP",   "showIpv4": true, "showIpv6": false },
    "separator",
    "colors"
  ]
}
