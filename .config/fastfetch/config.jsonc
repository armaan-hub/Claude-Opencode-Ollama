{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": " : ",
    "color": {
      "keys": "green",
      "title": "green"
    }
  },

  "logo": {
    "type": "builtin",
    "color": {
      "1": "green",
      "2": "bright_green"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "About This Mac"
    },
    "separator",
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    { "type": "terminal",     "key": "Terminal" },
    { "type": "terminalfont", "key": "Terminal Font" },
    "display",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "separator",
    "colors"
  ]
}
